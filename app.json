{
  "expo": {
    "name": "Pluma",
    "slug": "pluma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pluma",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1210",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "gt.pluma.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Pluma usa la cámara únicamente para escanear códigos QR de pago.",
        "NSFaceIDUsageDescription": "Pluma usa Face ID para proteger tus envíos y tu frase semilla."
      }
    },
    "android": {
      "package": "gt.pluma.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1210",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.USE_BIOMETRIC"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1210",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Pluma usa la cámara únicamente para escanear códigos QR de pago."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pluma usa Face ID para proteger tus envíos y tu frase semilla."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
